<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Karadag Beat</title>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="vst3" title="VST3 plugin" description="Ableton Live, FL Studio, Cubase, Studio One, Reaper, Bitwig">
        <pkg-ref id="com.karadag.karadagbeat.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="Logic Pro, GarageBand, and other AU hosts">
        <pkg-ref id="com.karadag.karadagbeat.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="Runs without a DAW">
        <pkg-ref id="com.karadag.karadagbeat.app"/>
    </choice>

    <pkg-ref id="com.karadag.karadagbeat.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.karadag.karadagbeat.au"   version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.karadag.karadagbeat.app"  version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
